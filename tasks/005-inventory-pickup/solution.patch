new file mode 100644
index 0000000..99c6ada
--- /dev/null
+++ b/scripts/pickup.gd
@@ -0,0 +1,14 @@
+extends Area2D
+
+@export var item_id: StringName
+@export var qty := 1
+
+
+func _ready() -> void:
+	body_entered.connect(_on_body_entered)
+
+
+func _on_body_entered(body: Node2D) -> void:
+	if body is Player:
+		body.inventory.add(item_id, qty)
+		queue_free()
