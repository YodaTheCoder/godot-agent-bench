diff --git a/scripts/components/health.gd b/scripts/components/health.gd
index 0474d11..54d2344 100644
--- a/scripts/components/health.gd
+++ b/scripts/components/health.gd
@@ -2,6 +2,8 @@ class_name Health
 extends Node
 
 signal died
+## Emitted whenever `current` changes through damage() or heal().
+signal health_changed(current: int, max_health: int)
 
 @export var max_health := 100
 
@@ -15,10 +17,16 @@ func _ready() -> void:
 func damage(amount: int) -> void:
 	if current == 0:
 		return
+	var previous := current
 	current = maxi(current - amount, 0)
+	if current != previous:
+		health_changed.emit(current, max_health)
 	if current == 0:
 		died.emit()
 
 
 func heal(amount: int) -> void:
+	var previous := current
 	current += amount
+	if current != previous:
+		health_changed.emit(current, max_health)
diff --git a/scripts/hud.gd b/scripts/hud.gd
index 9311309..9fac252 100644
--- a/scripts/hud.gd
+++ b/scripts/hud.gd
@@ -2,7 +2,23 @@ class_name HUD
 extends CanvasLayer
 
 @onready var score_label: Label = $ScoreLabel
+@onready var health_label: Label = $HealthLabel
 
 
-func _process(_delta: float) -> void:
-	score_label.text = "Score: %d" % ScoreManager.score
+func _ready() -> void:
+	ScoreManager.score_changed.connect(_on_score_changed)
+	_on_score_changed(ScoreManager.score)
+
+
+## Shows `health` in the health label and keeps it up to date via `health_changed`.
+func bind_health(health: Health) -> void:
+	health.health_changed.connect(_on_health_changed)
+	_on_health_changed(health.current, health.max_health)
+
+
+func _on_score_changed(score: int) -> void:
+	score_label.text = "Score: %d" % score
+
+
+func _on_health_changed(current: int, max_health: int) -> void:
+	health_label.text = "HP: %d/%d" % [current, max_health]
